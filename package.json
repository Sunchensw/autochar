{
  "name": "autochar",
  "version": "0.1.0",
  "private": true,
  "description": "Autochar Playwright recorder and operator console MVP",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "npm run start -w @autochar/demo-admin",
    "recorder": "npm run start -w @autochar/recorder",
    "operator": "npm run start -w @autochar/operator-console",
    "convert": "npm run start -w @autochar/flow-converter --",
    "batch": "npm run start -w @autochar/batch-runner --",
    "diagnose:recorder": "node scripts/diagnose-recorder-page.mjs",
    "prepare:browsers": "node scripts/ensure-playwright-browsers.mjs",
    "package:user": "node scripts/package-user.mjs",
    "package:owner": "node scripts/package-owner.mjs",
    "package:all": "node scripts/package-all.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.3",
    "@types/adm-zip": "^0.5.5",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.12",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "jsdom": "^24.1.1",
    "playwright": "^1.45.3",
    "tsup": "^8.2.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.4"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "express": "^4.19.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  }
}
